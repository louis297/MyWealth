# For more info on HTTP files go to https://aka.ms/vs/httpfile
@Web_HostAddress = https://localhost:7038

@Email=admin@localhost
@Password=Administrator1!
@BearerToken=<YourToken>

# POST /auth/login
POST {{Web_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

# POST /auth/logout
POST {{Web_HostAddress}}/auth/logout
Authorization: Bearer {{BearerToken}}

###

# GET /users/me
GET {{Web_HostAddress}}/users/me
Authorization: Bearer {{BearerToken}}

###

# PUT /users/me
PUT {{Web_HostAddress}}/users/me
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "displayName": "System Admin"
}

###

# PUT /users/me/password
PUT {{Web_HostAddress}}/users/me/password
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "currentPassword": "{{Password}}",
  "newPassword": "Administrator2!"
}

###

# GET /tenants
GET {{Web_HostAddress}}/tenants?page=1&pageSize=20
Authorization: Bearer {{BearerToken}}

###

# GET /tenants/{id}
GET {{Web_HostAddress}}/tenants/1
Authorization: Bearer {{BearerToken}}

###

# POST /tenants
POST {{Web_HostAddress}}/tenants
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "Acme Wealth"
}

###

# PUT /tenants/{id}
PUT {{Web_HostAddress}}/tenants/1
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "id": 1,
  "name": "Acme Wealth Ltd",
  "isEnabled": true
}

###

# GET /tenant-admins
GET {{Web_HostAddress}}/tenant-admins?page=1&pageSize=20
Authorization: Bearer {{BearerToken}}

###

# GET /tenant-admins/{id}
GET {{Web_HostAddress}}/tenant-admins/1
Authorization: Bearer {{BearerToken}}

###

# POST /tenant-admins
POST {{Web_HostAddress}}/tenant-admins
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "tenantId": 1,
  "name": "Alice Chen",
  "email": "alice.chen@acme.com",
  "password": "P@ssw0rd!"
}

###

# PUT /tenant-admins/{id}
PUT {{Web_HostAddress}}/tenant-admins/1
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "id": 1,
  "name": "Alice Chen",
  "isEnabled": true
}

###

# DELETE /tenant-admins/{id}
DELETE {{Web_HostAddress}}/tenant-admins/1
Authorization: Bearer {{BearerToken}}

###

# GET /advisers
GET {{Web_HostAddress}}/advisers?page=1&pageSize=20
Authorization: Bearer {{BearerToken}}

###

# GET /advisers/{id}
GET {{Web_HostAddress}}/advisers/1
Authorization: Bearer {{BearerToken}}

###

# POST /advisers
POST {{Web_HostAddress}}/advisers
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "Jane Smith",
  "email": "jane.smith@acme.com",
  "password": "P@ssw0rd!"
}

###

# PUT /advisers/{id}
PUT {{Web_HostAddress}}/advisers/1
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "id": 1,
  "name": "Jane Smith",
  "isEnabled": true
}

###

# DELETE /advisers/{id}
DELETE {{Web_HostAddress}}/advisers/1
Authorization: Bearer {{BearerToken}}

###

# GET /customers
GET {{Web_HostAddress}}/customers?page=1&pageSize=20
Authorization: Bearer {{BearerToken}}

###

# GET /customers/{id}
GET {{Web_HostAddress}}/customers/1
Authorization: Bearer {{BearerToken}}

###

# POST /customers
POST {{Web_HostAddress}}/customers
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "name": "Zhang San",
  "email": "zhangsan@example.com",
  "adviserId": 12
}

###

# PUT /customers/{id}
PUT {{Web_HostAddress}}/customers/1
Authorization: Bearer {{BearerToken}}
Content-Type: application/json

{
  "id": 1,
  "name": "Zhang San",
  "isEnabled": true,
  "adviserId": 12
}

###

# DELETE /customers/{id}
DELETE {{Web_HostAddress}}/customers/1
Authorization: Bearer {{BearerToken}}

###
